# ============================================================
# COPY THIS FILE AS .env AND FILL IN YOUR VALUES
# ============================================================

# --- SUPABASE DATABASE ---
# Get these from Supabase: Settings > Database > Connection string
# Use "Transaction" pooler (port 6543) for DATABASE_URL
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use "Session" pooler (port 5432) for DIRECT_URL
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- AUTH ---
# Generate a strong secret: https://generate-secret.vercel.app/32
JWT_SECRET="replace-this-with-a-long-random-secret"
